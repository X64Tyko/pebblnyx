# Build rules for a pebblnyx game.
#
# The only difference from a stock Pebble wscript is that the source glob reaches into
# src/c/pnx, which is a symlink to the framework. Keeping it inside the project tree is
# what lets waf resolve build outputs normally; pointing the glob outside `top` does
# not work.
#
# After linking, the size report runs automatically. That is the point of it: the 64KB
# ceiling is a uint16 that fails with an unreadable error when exceeded, so the
# breakdown has to be in front of you on every build, not on request.

import os
import os.path
import subprocess
import sys
import tomllib

top = '.'
out = 'build'


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    ctx.load('pebble_sdk')


# Derives the compile-time defines a project's OWN manifest requires from the manifest
# itself, rather than relying on a developer to notice tools/pnx_assets.py's own printed
# reminder ("set PNX_COMPRESS_MODE=... to match") and hand-edit pnx_config.h or PNX_DEFINES
# every time `compress`/`compress_maps` changes. Without this, a project whose src/c/pnx
# is a plain symlink to the shared framework (this one; Need4Pebble instead OWNS a copy
# it hand-edits directly, so it does not need this) silently compiles against
# pnx_config.h's own bare defaults regardless of what its manifest actually built --
# which decodes as a clean, silent refusal-to-load at runtime (every flag mismatch here
# refuses rather than misreads), not a build failure, so nothing catches it until the app
# is actually run. Exactly the "presents as nothing happens" class of bug
# tools/pnx_assets.py's own module docstring warns about.
_COMPRESS_MODE_DEFINE = {
    'none': 'PNX_COMPRESS_MODE=PNX_COMPRESS_NONE',
    'lzss': 'PNX_COMPRESS_MODE=PNX_COMPRESS_LZSS',
    'bitplane': 'PNX_COMPRESS_MODE=PNX_COMPRESS_BITPLANE',
}


def _manifest_defines(ctx):
    manifest_path = ctx.path.find_node('assets.toml')
    if not manifest_path:
        return []
    with open(manifest_path.abspath(), 'rb') as f:
        project = tomllib.load(f).get('project', {})
    defines = [_COMPRESS_MODE_DEFINE[project.get('compress', 'bitplane')]]
    if project.get('compress_maps', False):
        defines.append('PNX_USE_MAP_COMPRESS=1')
    return defines


def _size_report(ctx):
    # waf execs this file without __file__ defined, so the framework root is derived
    # from the build context rather than from the module path.
    framework_root = os.path.abspath(os.path.join(ctx.path.abspath(), '..', '..'))
    tool = os.path.join(framework_root, 'tools', 'size_report.py')
    for platform in ctx.env.TARGET_PLATFORMS:
        elf = os.path.join(out, platform, 'pebble-app.elf')
        if not os.path.exists(elf):
            continue
        print('\n--- {} size report ---'.format(platform))
        subprocess.call([sys.executable, tool, elf])


def build(ctx):
    ctx.load('pebble_sdk')

    # PNX_DEFINES lets a build override pnx_config.h without editing it, which is what
    # makes "does turning this module off actually reclaim the bytes?" a one-line check:
    #     PNX_DEFINES=PNX_USE_DIAGNOSTICS=0 pebble build
    # Manifest-derived defines go first so an explicit PNX_DEFINES always wins (a later
    # -D of the same macro silently overrides an earlier one; no clash either way) --
    # meant for one-off experiments, not for permanently disagreeing with the manifest.
    extra = _manifest_defines(ctx) + [d for d in os.environ.get('PNX_DEFINES', '').split() if d]

    binaries = []
    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        ctx.set_group(ctx.env.PLATFORM_NAME)
        if extra:
            ctx.env.append_value('DEFINES', extra)
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)

        # follow_symlinks so the framework symlink is traversed rather than skipped.
        # The host platform is excluded here as well as being #ifdef'd out, so a device
        # build never compiles it at all.
        sources = ctx.path.ant_glob('src/c/**/*.c',
                                    excl=['**/pnx_platform_host.c'],
                                    follow_symlinks=True)
        ctx.pbl_build(source=sources, target=app_elf, bin_type='app')
        binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env

    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries, js=[])

    ctx.add_post_fun(_size_report)
