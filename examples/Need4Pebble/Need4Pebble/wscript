# Build rules for a pebblnyx game. Generated by the editor; safe to edit.
#
# The source glob reaches into src/c/pnx, where the editor stages its copy of the engine
# immediately before each build. That directory is a build artefact rather than project
# source -- the engine lives in the editor, so a project built on another machine uses
# the engine there rather than carrying its own.
#
# After linking, the size report runs automatically -- every other example under
# pebblnyx/examples/ does this (see e.g. quickstart/wscript's own comment on why: the
# 64KB static-RAM ceiling is a uint16 that fails with an unreadable error when exceeded,
# so the breakdown needs to be in front of you on every build). This project's wscript
# was missing it, which is why `pebble build` here showed no package sizes even though
# every sibling example did. framework_root goes up THREE levels, not the usual two --
# this project sits at examples/Need4Pebble/Need4Pebble, one folder deeper than a normal
# examples/<name> project.

import os
import os.path
import subprocess
import sys

top = '.'
out = 'build'


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    ctx.load('pebble_sdk')


def _size_report(ctx):
    # waf execs this file without __file__ defined, so the framework root is derived
    # from the build context rather than from the module path.
    framework_root = os.path.abspath(os.path.join(ctx.path.abspath(), '..', '..', '..'))
    tool = os.path.join(framework_root, 'tools', 'size_report.py')
    for platform in ctx.env.TARGET_PLATFORMS:
        elf = os.path.join(out, platform, 'pebble-app.elf')
        if not os.path.exists(elf):
            continue
        print('\n--- {} size report ---'.format(platform))
        subprocess.call([sys.executable, tool, elf])


def build(ctx):
    ctx.load('pebble_sdk')

    # Lets a build override pnx_config.h without editing it:
    #     PNX_DEFINES=PNX_USE_DIAGNOSTICS=0 pebble build
    extra = [d for d in os.environ.get('PNX_DEFINES', '').split() if d]

    binaries = []
    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        ctx.set_group(ctx.env.PLATFORM_NAME)
        if extra:
            ctx.env.append_value('DEFINES', extra)
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)

        # The host platform is excluded here as well as being #ifdef'd out, so a device
        # build never compiles it at all.
        sources = ctx.path.ant_glob('src/c/**/*.c',
                                    excl=['**/pnx_platform_host.c'],
                                    follow_symlinks=True)
        ctx.pbl_build(source=sources, target=app_elf, bin_type='app')
        binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env

    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries, js=[])

    ctx.add_post_fun(_size_report)
